{
  "name": "skyrail-manutencao",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/gerar-versao.mjs && node scripts/gerar-csp.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "test:db": "bash scripts/test-db.sh",
    "criar-usuario": "node --env-file-if-exists=.env.admin scripts/criar-usuario.mjs",
    "importar-checklists": "node --env-file-if-exists=.env.admin scripts/importar-checklists.mjs",
    "checar:segredos": "node scripts/checar-segredos.mjs",
    "testar:homol": "node scripts/testar-homol.mjs",
    "e2e": "node scripts/e2e/ponta-a-ponta.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.8",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
