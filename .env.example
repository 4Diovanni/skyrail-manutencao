# Copie para .env.local e preencha. Só a chave pública (anon) entra no front.
# A service_role key NUNCA vai para este arquivo nem para o repositório.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon
# Domínio usado só para montar o usuário a partir do RE (ex.: 53000000 -> 53000000@l17.local).
# Não precisa existir; nenhum e-mail é enviado.
VITE_LOGIN_DOMAIN=l17.local
